# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=zapvibe-secret-key-mude-isso

# Groq (gratis em console.groq.com)
GROQ_API_KEY=sua_groq_api_key_aqui

# Configuracoes de disparo
INSTANCE_NAME=minha-empresa
DELAY_MIN=8000
DELAY_MAX=20000
DAILY_LIMIT=150
USE_AI=true

# Banco de dados PostgreSQL (Railway ou local)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# URL publica do servidor (para webhook da Evolution API)
# Em producao: https://seu-app.up.railway.app
# Local: deixar vazio (usa host.docker.internal)
WEBHOOK_BASE_URL=
